datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model KnowledgeDocument {
  id         String   @id @default(uuid())
  title      String
  filename   String
  mimeType   String
  size       Int
  status     String
  chunkCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
